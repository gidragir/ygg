<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <!-- Note: Windows Sandbox requires an absolute path on host. Adjust HostFolder to your local path if needed -->
    <MappedFolder>
      <HostFolder>C:\projects\ygg</HostFolder>
      <SandboxFolder>C:\ygg</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -NoExit -Command "Set-Location C:\ygg; if (-not (Get-Command nu -ErrorAction SilentlyContinue)) { .\scripts\install.ps1 }; nu tests\run.nu"</Command>
  </LogonCommand>
</Configuration>
